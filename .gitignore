# 创世纪项目 - GitHub公开仓库忽略规则
# 注意：本仓库仅公开设计文档，不暴露源码

# 源代码目录
src/

# 测试文件
tests/

# 授权文件（含编译产物）
AUTH-BP-*.json

# Python缓存
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# 虚拟环境
venv/
env/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo

# 操作系统
.DS_Store
Thumbs.db

# 日志
*.log
logs/

# 临时文件
temp/
tmp/
*.tmp

# 构建产物
dist/
build/
*.egg-info/

# 敏感配置
.env
*.secret
*.key

# 本地资源服务器缓存
local-assets/cache/

# Node模块
node_modules/

# 知识库中的构建产物和依赖
knowledge-base/**/dist/
knowledge-base/**/node_modules/
knowledge-base/**/package-lock.json

# 大型二进制文件
*.exe
*.dll
*.so
*.dylib

# 数据文件
*.db
*.sqlite
*.sqlite3
